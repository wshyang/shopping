{
  "name": "shopper",
  "version": "0.1.0",
  "description": "PDD review-count collector — Manifest V3 extension (WXT + TypeScript)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "LIVE=1 playwright test --config=playwright.live.config.ts",
    "recon:browser": "node scripts/recon/browser.mjs",
    "recon:harvest": "node scripts/recon/harvest.mjs",
    "recon:capture": "node scripts/recon/capture.mjs",
    "recon:sanitize": "node scripts/recon/sanitize.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.280",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.20.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.1.0",
    "wxt": "^0.19.13"
  }
}
