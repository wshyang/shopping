stages: [test, build]
default:
  image: mcr.microsoft.com/playwright:v1.56.1-noble
  before_script:
    - npm ci
quality-job:
  stage: test
  script:
    - npm run typecheck
    - npm run lint
    - npm run format:check
    - npm run test:coverage
    - npm run build
    - npm run test:e2e
  artifacts:
    when: always
    paths: [coverage/, test-results/, playwright-report/]
build-job:
  stage: build
  script:
    - npm run zip
  artifacts:
    paths: [.output/*.zip]
