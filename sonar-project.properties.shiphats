# SHIP-HATS inert — activate with ./activate-shiphats.sh
sonar.projectKey=@@SHIPHATS_SONAR_PROJECTKEY@@
sonar.sources=src,entrypoints
sonar.tests=tests
sonar.javascript.lcov.reportPaths=coverage/lcov.info
sonar.exclusions=node_modules/**,.output/**,.wxt/**,dist/**,coverage/**,playwright-report/**,test-results/**
sonar.sourceEncoding=UTF-8
